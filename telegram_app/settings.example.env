# Public HTTPS address of the FastAPI server / Mini App.
APP_URL=https://your-domain.example
# Token obtained from @BotFather. Keep it private and never commit this file.
TELEGRAM_BOT_TOKEN=
# On Railway with a persistent volume: /data/control.sqlite3
# DATABASE_PATH=/data/control.sqlite3
# Optional: only for opening the Mini App in a regular browser during development.
# DEV_TELEGRAM_USER_ID=
